[Unit]
Description=zish - fast Zig shell
Documentation=man:zish(1)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/zish
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
