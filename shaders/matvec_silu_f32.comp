// Fused mat-vec + SiLU for f32 weights:
//   out[dst_offset + row] = SiLU(dot(weights_f32[row, :], input_f32[src_offset + :]))
// where SiLU(x) = x / (1 + exp(-x))
//
// Used for SynapseUNET cascade: eliminates output→CPU→input roundtrips.

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Weights { float w[]; };
layout(set = 0, binding = 1) readonly buffer Input { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint weight_offset;
    uint src_offset;
    uint dst_offset;
};

const uint NUM_ROWS = 2;
shared float tmpsh[NUM_ROWS][8];

void main() {
    uint first_row = gl_WorkGroupID.x * NUM_ROWS;
    uint tid = gl_LocalInvocationID.x;
    uint num_rows = min(NUM_ROWS, rows - first_row);
    if (first_row >= rows) return;

    float temp[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) temp[n] = 0.0;

    uint col = tid * 2;
    uint stride = 256 * 2;

    while (col + 1 < cols) {
        float x0 = x[src_offset + col];
        float x1 = x[src_offset + col + 1];
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            if (n < num_rows) {
                uint base = weight_offset + (first_row + n) * cols;
                temp[n] += w[base + col] * x0 + w[base + col + 1] * x1;
            }
        }
        col += stride;
    }
    if (col < cols) {
        float x0 = x[src_offset + col];
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            if (n < num_rows) {
                uint base = weight_offset + (first_row + n) * cols;
                temp[n] += w[base + col] * x0;
            }
        }
    }

    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        temp[n] = subgroupAdd(temp[n]);
    }

    if (subgroupElect()) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            tmpsh[n][gl_SubgroupID] = temp[n];
        }
    }
    barrier();

    if (tid == 0) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            if (n < num_rows) {
                float total = 0.0;
                for (uint s = 0; s < gl_NumSubgroups; ++s) {
                    total += tmpsh[n][s];
                }
                // SiLU activation: x / (1 + exp(-x))
                y[dst_offset + first_row + n] = total / (1.0 + exp(-total));
            }
        }
    }
}
