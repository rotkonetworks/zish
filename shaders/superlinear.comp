// SuperLinear compute shader: per-neuron independent mat-vec
//
// Implements: out[n, o] = sum_m(x[n, m] * w[m, o, n]) + b[n, o]
// Where: N neurons, M input dims, O output dims
// Weight layout: w[M, O, N] row-major (same as CPU)
//
// One workgroup per neuron. Threads split the O dimension.
// For CTM NLM1: N=896, M=16, O=64 — 896 workgroups, trivial per-thread work
// For CTM NLM2: N=896, M=32, O=2 — 896 workgroups, even less work
//
// This shader exists because SuperLinear is NOT standard matmul:
// it's N independent (M×O) matmuls, one per neuron. On CPU this is
// a triple-nested loop. On GPU each neuron gets its own workgroup.
//
// Memory layout in input buffer:
//   [0..N*M*4]: input x[N, M] as f32
//   [N*M*4..N*M*4+N*O*4]: bias b[N, O] as f32
//
// Weight buffer (at weight_offset):
//   w[M, O, N] as f32 — stride is O*N for the M dimension

#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

// Binding 0: weights (f32 for SuperLinear — CTM weights are f32)
layout(set = 0, binding = 0) readonly buffer Weights {
    float w[];
};

// Binding 1: input (x[N,M] followed by bias[N,O])
layout(set = 0, binding = 1) readonly buffer Input {
    float input_data[];
};

// Binding 2: output
layout(set = 0, binding = 2) writeonly buffer Output {
    float y[];
};

layout(push_constant) uniform PC {
    uint n_neurons; // N
    uint in_dims;   // M
    uint out_dims;  // O
    uint weight_offset; // f32 element offset into weight buffer
};

void main() {
    uint n = gl_WorkGroupID.x; // neuron index
    if (n >= n_neurons) return;

    uint tid = gl_LocalInvocationID.x;

    // Each thread handles a subset of output dimensions
    for (uint o = tid; o < out_dims; o += 256) {
        // Bias
        float sum = input_data[n_neurons * in_dims + n * out_dims + o];

        // Dot product: sum_m(x[n, m] * w[m, o, n])
        for (uint m = 0; m < in_dims; m++) {
            // x[n, m]
            float x_val = input_data[n * in_dims + m];
            // w[m, o, n] = w[(m * out_dims + o) * n_neurons + n]
            float w_val = w[weight_offset + (m * out_dims + o) * n_neurons + n];
            sum += x_val * w_val;
        }

        y[n * out_dims + o] = sum;
    }
}
