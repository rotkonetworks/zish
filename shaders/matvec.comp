// Mat-vec compute shader: out[dst_offset + row] = dot(weights_f16[row, :], input_f32[src_offset + :])
//
// Based on llama.cpp's mul_mat_vec pattern with RDNA3 tuning.
//
// Key optimizations (learned from llama.cpp + tinyblas):
//   - NUM_ROWS=2: each workgroup computes 2 output rows, amortizing input reads
//   - K_PER_ITER=2: process 2 columns per loop iteration (ILP)
//   - Subgroup reduction (wave64 on RDNA3, wave32 on RDNA2) + shared memory
//   - Coalesced F16 weight reads from VRAM
//   - Workgroup size 256 = 4 waves of 64 (fills one CU on RDNA3)
//
// Model-agnostic: rows, cols, weight_offset, src_offset, dst_offset are push constants.
// src_offset/dst_offset enable batched operation: multiple matmuls share one
// command buffer, reading/writing to different regions of the input/output buffers.

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256) in;

// Binding 0: weights (f16)
layout(set = 0, binding = 0) readonly buffer Weights {
    float16_t w[];
};

// Binding 1: input vector (f32)
layout(set = 0, binding = 1) readonly buffer Input {
    float x[];
};

// Binding 2: output vector (f32)
layout(set = 0, binding = 2) writeonly buffer Output {
    float y[];
};

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint weight_offset;  // in f16 elements
    uint src_offset;     // in f32 elements into input buffer
    uint dst_offset;     // in f32 elements into output buffer
};

// Each workgroup computes NUM_ROWS output elements
const uint NUM_ROWS = 2;

// Shared memory for cross-subgroup reduction
shared float tmpsh[NUM_ROWS][8]; // max 256/32 = 8 subgroups

void main() {
    uint first_row = gl_WorkGroupID.x * NUM_ROWS;
    uint tid = gl_LocalInvocationID.x;

    // Handle edge case: last workgroup may have fewer rows
    uint num_rows = min(NUM_ROWS, rows - first_row);
    if (first_row >= rows) return;

    // Accumulate dot products for NUM_ROWS rows
    float temp[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        temp[n] = 0.0;
    }

    // Main loop: each thread strides across columns
    // Process 2 columns per iteration for better ILP
    uint col = tid * 2;
    uint stride = 256 * 2;

    while (col + 1 < cols) {
        // Load 2 input values (shared across all rows)
        float x0 = x[src_offset + col];
        float x1 = x[src_offset + col + 1];

        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            if (n < num_rows) {
                uint base = weight_offset + (first_row + n) * cols;
                float w0 = float(w[base + col]);
                float w1 = float(w[base + col + 1]);
                temp[n] += w0 * x0 + w1 * x1;
            }
        }
        col += stride;
    }
    // Handle odd column
    if (col < cols) {
        float x0 = x[src_offset + col];
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            if (n < num_rows) {
                uint base = weight_offset + (first_row + n) * cols;
                temp[n] += float(w[base + col]) * x0;
            }
        }
    }

    // Reduction: subgroupAdd + shared memory
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        temp[n] = subgroupAdd(temp[n]);
    }

    // Write subgroup partials to shared memory
    if (subgroupElect()) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            tmpsh[n][gl_SubgroupID] = temp[n];
        }
    }
    barrier();

    // Thread 0 sums across subgroups and writes output
    if (tid == 0) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            if (n < num_rows) {
                float total = 0.0;
                for (uint s = 0; s < gl_NumSubgroups; ++s) {
                    total += tmpsh[n][s];
                }
                y[dst_offset + first_row + n] = total;
            }
        }
    }
}
